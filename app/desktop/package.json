{
  "name": "pantler-desktop",
  "productName": "pantler",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "description": "pantler's desktop host: the same web bundle, with the engine and the BFF supervised.",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "desktop:dev": "electron .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "build:win": "electron-builder --win nsis --publish never --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
